# ==========================================
# TRUEHIVE CRM & ERP - ENVIRONMENT TEMPLATE (.env.example)
# ==========================================

# 1. Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# 2. JWT & Auth Security
JWT_SECRET=""
JWT_REFRESH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Redis (Upstash)
REDIS_URL="rediss://default:token@host:6379"

# 4. Pusher (Real-time Live Chat & POS Stock Sync)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# 5. Firebase (FCM Push Notifications)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# 6. Cloudinary (Products, Payment Slips, Voice Notes & Invoices)
CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# 7. Resend (Transactional Emails & Official Invoices)
RESEND_API_KEY=""
EMAIL_FROM="TrueHive CRM <support@yourdomain.com>"

# 8. Zoho Marketing Campaigns
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_AUTH_CODE=""

# 9. Google Gemini AI (Agentic Loop & Multimodal)
GEMINI_API_KEY=""
GEMINI_MARKETING_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 10. WhatsApp Cloud API (Meta Official)
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# 11. Google Docs & Google Sheets Live Reporting API
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_LIVE_DOC_ID=""
GOOGLE_LIVE_SHEET_ID=""
PORT=4000
